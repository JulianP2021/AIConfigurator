# Distributed LLM inference simulator defaults
# These values are used by main.py unless overridden by CLI arguments.

# Model and request shape
MODEL=Qwen/Qwen3.8-27B
ISL=25000
OSL=15000

# Scenario scale
SESSIONS_PER_USER=30
USERS=40
MAX_SESSION_TURNS=6
THINK_TIME_MS=1000

# Per-user random delay (added on top of THINK_TIME_MS)
# 1h
USER_DELAY_FRACTION=0.01
USER_DELAY_MIN_MS=3600000
USER_DELAY_MAX_MS=3600000

# Mean startup arrival offset per user, drawn from an exponential distribution.
# 0 means all users start at t=0.
STARTUP_ARRIVAL_MEAN_MS=3600000.0

# Random seed for reproducible request timing (including user delays and startup offsets).
# Leave empty to use Python's default non-deterministic RNG state.
RANDOM_SEED=42

# Per-request latency SLAs. Must be finite positive numbers because the
# request generator builds a deterministic arrival schedule from them.
SLA_TTFT_MS=15000
SLA_TPOT_MS=70

# Topology
BATCH_SIZE=100
NUM_PREFILL_NODES=1
NUM_DECODE_NODES=1
PREFILL_GPUS_PER_NODE=4
PREFILL_HARDWARE=AWS p5en.48xlarge (H200 x8)

# Mixed-GPU topology (colocated node with different prefill/decode GPU types)
MIXED_GPU_DONOR=
MIXED_GPU_COUNT=-1

# GPU compute/bandwidth split; must match the split in pricing.json
GPU_COMPUTE_FRACTION=0.6

# Cache
RAM_USAGE_FRACTION=0.8
SSD_USAGE_FRACTION=0.8

# Shared S3/object-store cache fallback
S3_ENABLED=true
S3_UP_BW_GBPS=2500.0
S3_DOWN_BW_GBPS=2500.0
# 100 h
S3_EVICTION_TIME_MS=360000000

# Inter-node (datacenter NIC) bandwidth used for node-to-node KV transfers.
INTER_NODE_NETWORK_UP_GBPS=100.0
INTER_NODE_NETWORK_DOWN_GBPS=100.0

# Dynamo-style KV cache routing cost parameters (tokens).
# Higher credit means the router prefers workers that already hold that KV tier.
ROUTER_PREFILL_LOAD_SCALE=1.0
ROUTER_ACTIVE_WORK_SCALE=0.05
ROUTER_DEVICE_CREDIT=0.6
ROUTER_REMOTE_RAM_CREDIT=0.0
ROUTER_REMOTE_SSD_CREDIT=0.0
ROUTER_S3_CREDIT=0.0

# Logging bitmask:
#   bit 0 (value 1)  = cache
#   bit 1 (value 2)  = instances (prefill/decode)
#   bit 2 (value 4)  = router
#   bit 3 (value 8)  = simulation
#   bit 4 (value 16) = bandwidth
#   bit 5 (value 32) = config executor
# Examples: 0 = none, 1 = cache only, 4 = router only, 63 = everything.
LOG_MASK=0

DEBUG=false
